{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  // Applied against a live database as a migration step, not built with
  // the library: it talks to `pg` directly so it can run before the ORM
  // barrel is loadable.
  "exclude": ["src/apply-rls.ts"]
}
