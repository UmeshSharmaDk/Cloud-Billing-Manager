# Copy to .env for local development. Never commit a filled-in copy —
# .gitignore excludes .env and .env.*, and this example is the one exception.

# Local Postgres connection string. The API uses this in development unless
# DEVELOPMENT_APP_DATABASE_URL is set. In production, DATABASE_URL is reserved for schema
# operations and the API refuses to start without APP_DATABASE_URL.
DATABASE_URL=postgres://gst_app:change-me@127.0.0.1:5432/gst

# Dedicated production application connection. Must be NOSUPERUSER NOBYPASSRLS.
# Set this as a production secret; it is ignored by development and local RLS tests.
# Do not point the production API at the owner URL.
# See lib/db/README-rls.md.
APP_DATABASE_URL=
# Optional restricted development/scratch connection, separate from production.
DEVELOPMENT_APP_DATABASE_URL=postgres://gst_app:change-me@127.0.0.1:5432/gst
# NODE_ENV=test requires an explicit disposable application database.
# TEST_APP_DATABASE_URL=postgres://gst_app:change-me@127.0.0.1:5432/gst_test

# Owner connection, used only for `push` and `rls:apply` (never by the server).
ADMIN_DATABASE_URL=postgres://postgres@127.0.0.1:5432/gst

# Session signing key. Required, minimum 32 characters, no default.
# Generate with: openssl rand -base64 48
# Rotating this invalidates every issued session immediately.
SESSION_SECRET=

# Browser origins allowed to call the API. Required, comma-separated,
# scheme://host with no trailing slash. Never "*".
ALLOWED_ORIGINS=http://localhost:25512

# SameSite policy for the session cookie: lax (default) | strict | none.
# Use "none" only when the app and API are on different sites; it requires HTTPS.
COOKIE_SAME_SITE=lax

# Registration email. Production refuses to boot without PRODUCTION_SMTP_URL.
# This must be a Replit Secret; do not put a filled-in value in this file.
# Hostinger uses smtp.hostinger.com:587 with STARTTLS, or :465 with SSL.
# Development only: SMTP_URL is optional and, if set, enables local SMTP sending.
SMTP_URL=
# Required production credential; ignored when NODE_ENV=development.
PRODUCTION_SMTP_URL=
MAIL_FROM="GST Platform <no-reply@example.com>"
# Where the emailed link points (the web app). Defaults to the first allowed origin.
APP_BASE_URL=

# Reverse-proxy hops between the internet and the API (default 1). Per-address
# lockouts and rate limits read the client address from X-Forwarded-For using this
# many trusted hops; set it to match your platform (a CDN in front adds one).
TRUST_PROXY=1

# Optional limits. Defaults shown.
# AUTH_RATE_LIMIT_MAX=30
# REGISTER_RATE_LIMIT_MAX=10
# TENANT_WRITE_RATE_LIMIT_MAX=300
# TENANT_READ_RATE_LIMIT_MAX=1200
# Requests one business may have in progress at once; keep below DB_POOL_MAX.
# TENANT_MAX_IN_FLIGHT=16
# DB_POOL_MAX=20

# Ports. The API and the web app each require their own.
PORT=8080
BASE_PATH=/

# Set to "true" to skip the Have I Been Pwned breach lookup on new passwords
# (for offline or air-gapped environments). The local policy checks still apply.
DISABLE_BREACH_CHECK=false

# "development" gives pretty logs, relaxed cookie security and logs mail instead of
# sending it. Anything else — including unset — is treated as production. This
# example is for local work; deployments must NOT copy this line.
NODE_ENV=development
